generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String

  tarefa tarefa[]
}

model tarefa {
  id            Int        @id @default(autoincrement())
  id_usuario    Int
  descrição   String?
  nome_setor    String
  prioridade    Prioridade
  data_cadastro String
  status        Status     @default(A_FAZER)

  usuario usuario @relation(fields: [id_usuario], references: [id])
}

enum Status {
  A_FAZER
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}
